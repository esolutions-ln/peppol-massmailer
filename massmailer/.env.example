# ── PostgreSQL (existing platform instance) ──
DB_HOST=your-postgres-hostname.platform.com
DB_PORT=5432
DB_USER=mailer
POSTGRES_PASSWORD=your_secure_postgres_password

# ── Brevo transactional API (required in production) ──
# Mail is sent via POST https://api.brevo.com/v3/smtp/email (not SMTP).
# API key: Brevo dashboard → SMTP & API → API Keys (starts with xkeysib-).
# MAIL_FROM and every organisation's senderEmail must be verified Brevo senders.
BREVO_ENABLED=true
BREVO_API_KEY=xkeysib-your_brevo_api_key
# Shared secret for POST /webhooks/brevo/transactional (generate: openssl rand -hex 32),
# then register the webhook with scripts/register-brevo-webhook.sh
BREVO_WEBHOOK_TOKEN=

# ── SMTP fallback (optional — only used when BREVO_ENABLED=false) ──
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ── Email ──
MAIL_FROM=no-reply@invoicedirect.biz
MAIL_FROM_NAME=InvoiceDirect Mailer

# ── App ──
APP_BASE_URL=https://ap.invoicedirect.biz
RATE_LIMIT=100
BATCH_SIZE=50
MAX_PDF_BYTES=10485760
HIBERNATE_DDL_AUTO=validate
SWAGGER_ENABLED=true

# ── Admin (required — bootstraps the default admin user) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password

# ── Webhook signing (required — must be >=32 chars) ──
WEBHOOK_SECRET=your_webhook_signing_secret_min_32_chars

# ── Google OAuth (optional — only if massmailer.gmail-oauth2.enabled=true) ──
GOOGLE_OAUTH2_CREDENTIALS_PATH=
GOOGLE_OAUTH2_REFRESH_TOKEN=
